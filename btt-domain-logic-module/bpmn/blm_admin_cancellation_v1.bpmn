          <dc:Bounds x="894" y="217" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DecisionApproved" bpmnElement="DecisionApproved">
        <dc:Bounds x="1150" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1094.0" y="205" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
