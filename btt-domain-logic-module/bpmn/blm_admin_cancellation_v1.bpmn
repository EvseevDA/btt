        <dc:Bounds x="1450" y="260" width="145" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Refused" bpmnElement="Refused">
        <dc:Bounds x="1670" y="276" width="36" height="36" />
