        <bpmndi:BPMNLabel>
          <dc:Bounds x="1119" y="217" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApplyPositive" bpmnElement="ApplyPositive">
        <dc:Bounds x="1450" y="146" width="145" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Positive" bpmnElement="Positive">
        <dc:Bounds x="1670" y="162" width="36" height="36" />
