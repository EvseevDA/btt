<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_registration_amendment" targetNamespace="https://btt.github.io/processes" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <bpmn:message id="Message_Assigned" name="blm_registration_executor_assigned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Decided" name="blm_registration_decision_submitted">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Returned" name="blm_registration_decision_returned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Approved" name="blm_registration_decision_approved">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Withdraw" name="blm_registration_withdrawal_requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="blm_registration_amendment" name="Изменение регистрации перевозчика" isExecutable="true">
    <bpmn:documentation>Тип заявления: 2. Представитель организации подаёт изменения на основе текущей версии перевозчика. Назначение другого сотрудника требует transporter.amendment.assign и transporter.amendment.decide у назначающего, а взятие в работу и вынесение решения — transporter.amendment.decide. Исполнитель должен обладать этим разрешением. Согласование и возврат требуют transporter.amendment.approve. Сотрудник с обоими разрешениями может выполнить оба этапа. Отзыв доступен только подателю заявления до согласования, включая доработку. Разрешения, авторство и допустимость переходов проверяет бэкенд.</bpmn:documentation>
    <bpmn:startEvent id="Submitted" name="Заявление подано">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="WaitAssignment" name="Ожидать исполнителя">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Assigned" name="Назначено или взято в работу">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Assigned" messageRef="Message_Assigned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="SaveAssignment" name="Закрепить исполнителя за заявлением">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_save_registration_assignment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="WaitDecision" name="Ожидать решение">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="DecisionSubmitted" name="Решение передано">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_DecisionSubmitted" messageRef="Message_Decided" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="SaveDecision" name="Сохранить решение на согласование">
      <bpmn:documentation>Сохранить решение и вернуть decisionType из сохранённой записи: 1 — одобрить, 2 — отказать. До согласования сохраняется возможность доработки.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_save_registration_decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="WaitApproval" name="Ожидать согласование">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="DecisionApproved" name="Решение согласовано">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_DecisionApproved" messageRef="Message_Approved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="DecisionOutcome" name="Тип решения">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ApplyPositive" name="Выпустить новые версии перевозчика и РУ">
      <bpmn:documentation>Создаются новая версия перевозчика, новый полный набор записей лицензий, включая неизменённые, и связанная версия РУ. Организация сохраняется. Вид транспорта может измениться. Прежние данные доступны в истории.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_apply_registration_amendment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Positive" name="Положительное решение">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ApplyRefusal" name="Зафиксировать согласованный отказ">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_finalize_registration_refusal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Refused" name="Отказ">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="DecisionReturned" name="Возвращено на доработку">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_DecisionReturned" messageRef="Message_Returned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ReturnForRevision" name="Вернуть решение исполнителю">
      <bpmn:documentation>Сохранить причину возврата и оставить прежнего исполнителя. Новая редакция снова поступает на согласование.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_return_registration_decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="WithdrawAssignment" name="Отзыв до назначения">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_WithdrawAssignment" messageRef="Message_Withdraw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="WithdrawDecision" name="Отзыв до решения или при доработке">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_WithdrawDecision" messageRef="Message_Withdraw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="WithdrawApproval" name="Отзыв до согласования">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_WithdrawApproval" messageRef="Message_Withdraw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="MergeWithdrawal">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveWithdrawal" name="Зафиксировать отзыв подателем">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="blm_withdraw_registration_request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Withdrawn" name="Отозвано">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Submitted" targetRef="WaitAssignment" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="WaitAssignment" targetRef="Assigned" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Assigned" targetRef="SaveAssignment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="SaveAssignment" targetRef="WaitDecision" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="WaitDecision" targetRef="DecisionSubmitted" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="DecisionSubmitted" targetRef="SaveDecision" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SaveDecision" targetRef="WaitApproval" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="WaitApproval" targetRef="DecisionApproved" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="DecisionApproved" targetRef="DecisionOutcome" />
    <bpmn:sequenceFlow id="Flow_10" name="Одобрить" sourceRef="DecisionOutcome" targetRef="ApplyPositive">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionType = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ApplyPositive" targetRef="Positive" />
    <bpmn:sequenceFlow id="Flow_12" name="Отказать" sourceRef="DecisionOutcome" targetRef="ApplyRefusal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionType = 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ApplyRefusal" targetRef="Refused" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="WaitApproval" targetRef="DecisionReturned" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="DecisionReturned" targetRef="ReturnForRevision" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ReturnForRevision" targetRef="WaitDecision" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="WaitAssignment" targetRef="WithdrawAssignment" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="WaitDecision" targetRef="WithdrawDecision" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="WaitApproval" targetRef="WithdrawApproval" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="WithdrawAssignment" targetRef="MergeWithdrawal" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="WithdrawDecision" targetRef="MergeWithdrawal" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="WithdrawApproval" targetRef="MergeWithdrawal" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="MergeWithdrawal" targetRef="SaveWithdrawal" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="SaveWithdrawal" targetRef="Withdrawn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_registration_amendment">
    <bpmndi:BPMNPlane id="Plane_registration_amendment" bpmnElement="blm_registration_amendment">
      <bpmndi:BPMNShape id="Shape_Submitted" bpmnElement="Submitted">
        <dc:Bounds x="165" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="205" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
