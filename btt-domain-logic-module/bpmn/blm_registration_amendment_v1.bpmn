      <bpmndi:BPMNShape id="Shape_MergeWithdrawal" bpmnElement="MergeWithdrawal" isMarkerVisible="true">
        <dc:Bounds x="1290" y="480" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveWithdrawal" bpmnElement="SaveWithdrawal">
        <dc:Bounds x="1440" y="471" width="145" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Withdrawn" bpmnElement="Withdrawn">
        <dc:Bounds x="1650" y="487" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1644" y="530" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="201" y="180" />
        <di:waypoint x="290" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="180" />
        <di:waypoint x="410" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="446" y="180" />
        <di:waypoint x="520" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="665" y="180" />
        <di:waypoint x="710" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="760" y="180" />
        <di:waypoint x="825" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="861" y="180" />
        <di:waypoint x="935" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="1080" y="180" />
        <di:waypoint x="1125" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="1175" y="180" />
        <di:waypoint x="1240" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1276" y="180" />
        <di:waypoint x="1350" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="1400" y="180" />
        <di:waypoint x="1540" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1452" y="151" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11">
        <di:waypoint x="1685" y="180" />
        <di:waypoint x="1760" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12">
        <di:waypoint x="1375" y="205" />
        <di:waypoint x="1375" y="294" />
        <di:waypoint x="1540" y="294" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1454" y="265" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13">
        <di:waypoint x="1685" y="294" />
        <di:waypoint x="1760" y="294" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_14" bpmnElement="Flow_14">
        <di:waypoint x="1150" y="155" />
        <di:waypoint x="1150" y="91" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_15" bpmnElement="Flow_15">
        <di:waypoint x="1132" y="73" />
        <di:waypoint x="1020" y="73" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_16" bpmnElement="Flow_16">
        <di:waypoint x="875" y="73" />
        <di:waypoint x="735" y="73" />
