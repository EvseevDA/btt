<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_registration-request" targetNamespace="https://btt.github.io/processes">
  <bpmn:message id="Message_Assignment" name="Назначение исполнителя" />
  <bpmn:message id="Message_WithdrawBefore" name="Отзыв до назначения" />
  <bpmn:message id="Message_Decision" name="Вынесение решения" />
  <bpmn:message id="Message_WithdrawDuring" name="Отзыв при рассмотрении" />
  <bpmn:process id="registration-request" name="Рассмотрение заявления перевозчика" isExecutable="false">
    <bpmn:documentation>Перевозчик может инициировать регистрацию, изменение или отмену регистрации. Администрация портала может инициировать отмену регистрации. Оба сценария отмены проходят общий порядок рассмотрения и сохраняют свой тип заявления. После подачи и до вынесения решения инициатор может отозвать заявление. При одобрении применяется процесс registration-certificate.</bpmn:documentation>
    <bpmn:startEvent id="CarrierStart" name="Инициатива перевозчика">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CarrierDraft" name="Создать заявление на регистрацию, изменение или отмену">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="AdminStart" name="Инициатива администрации">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="AdminDraft" name="Оформить заявление на отмену регистрации">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="InitiatorMerge">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Submit" name="Подать заявление">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="WaitAssignment">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Assignment" name="Назначение исполнителя">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Assignment" messageRef="Message_Assignment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="WithdrawBefore" name="Отзыв до назначения">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_WithdrawBefore" messageRef="Message_WithdrawBefore" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Review" name="Перевести на рассмотрение">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="WaitDecision">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Decision" name="Вынесение решения">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Decision" messageRef="Message_Decision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="WithdrawDuring" name="Отзыв при рассмотрении">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_WithdrawDuring" messageRef="Message_WithdrawDuring" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Outcome" name="Решение">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Apply" name="Применить одобренное решение">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Approved" name="Одобрено">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Rejected" name="Отклонено">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="WithdrawMerge">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Withdrawn" name="Отозвано">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="CarrierStart" targetRef="CarrierDraft" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="AdminStart" targetRef="AdminDraft" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CarrierDraft" targetRef="InitiatorMerge" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="AdminDraft" targetRef="InitiatorMerge" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="InitiatorMerge" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Submit" targetRef="WaitAssignment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="WaitAssignment" targetRef="Assignment" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="WaitAssignment" targetRef="WithdrawBefore" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Assignment" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Review" targetRef="WaitDecision" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="WaitDecision" targetRef="Decision" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="WaitDecision" targetRef="WithdrawDuring" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Decision" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Outcome" targetRef="Apply" name="Одобрить" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Apply" targetRef="Approved" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Outcome" targetRef="Rejected" name="Отказать" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="WithdrawBefore" targetRef="WithdrawMerge" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="WithdrawDuring" targetRef="WithdrawMerge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="WithdrawMerge" targetRef="Withdrawn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_registration-request">
    <bpmndi:BPMNPlane id="Plane_registration-request" bpmnElement="registration-request">
      <bpmndi:BPMNShape id="Shape_CarrierStart" bpmnElement="CarrierStart">
