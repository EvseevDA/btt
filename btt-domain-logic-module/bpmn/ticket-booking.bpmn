<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ticket-booking" targetNamespace="https://btt.github.io/processes">
  <bpmn:process id="ticket-booking" name="Бронирование билета и отмена" isExecutable="false">
    <bpmn:documentation>Регистрация билета и отмена представлены как последовательность действий в течение жизненного цикла. При отсутствии места API бронирования возвращает HTTP 409. Номер и цена определяются сервером.</bpmn:documentation>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Выбрать рейс и место">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Check" name="Проверить доступность">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Available" name="Есть место?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Book" name="Создать билет">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="CancelChoice" name="Запрошена отмена?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Cancel" name="Отменить бронь">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Booked" name="Забронирован">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Cancelled" name="Отменён">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Conflict" name="Бронь отклонена">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Select" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Check" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Available" targetRef="Book" name="Да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Available" targetRef="Conflict" name="Нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Book" targetRef="CancelChoice" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="CancelChoice" targetRef="Booked" name="Нет" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="CancelChoice" targetRef="Cancel" name="Да" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Cancel" targetRef="Cancelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ticket-booking">
    <bpmndi:BPMNPlane id="Plane_ticket-booking" bpmnElement="ticket-booking">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="80" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Select" bpmnElement="Select">
        <dc:Bounds x="155" y="146" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check">
        <dc:Bounds x="330" y="146" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Available" bpmnElement="Available" isMarkerVisible="true">
        <dc:Bounds x="505" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456.0" y="212" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Book" bpmnElement="Book">
        <dc:Bounds x="670" y="146" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CancelChoice" bpmnElement="CancelChoice" isMarkerVisible="true">
        <dc:Bounds x="850" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="801.0" y="212" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Cancel" bpmnElement="Cancel">
        <dc:Bounds x="1010" y="255" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Booked" bpmnElement="Booked">
        <dc:Bounds x="1010" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="954.0" y="205" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Cancelled" bpmnElement="Cancelled">
        <dc:Bounds x="1210" y="271" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1154.0" y="314" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Conflict" bpmnElement="Conflict">
        <dc:Bounds x="670" y="285" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="614.0" y="328" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="180.0" />
        <di:waypoint x="155" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="180.0" />
        <di:waypoint x="330" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="460" y="180.0" />
        <di:waypoint x="505" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="555" y="180.0" />
        <di:waypoint x="670" y="180.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="554" y="150" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="530" y="205" />
        <di:waypoint x="530" y="303" />
        <di:waypoint x="670" y="303" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="282" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="800" y="180.0" />
        <di:waypoint x="850" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="900" y="180.0" />
        <di:waypoint x="1010" y="180.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="900" y="150" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="875" y="205" />
        <di:waypoint x="875" y="289" />
        <di:waypoint x="1010" y="289" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="905" y="268" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1140" y="289.0" />
        <di:waypoint x="1210" y="289.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>