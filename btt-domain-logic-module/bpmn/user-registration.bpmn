<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_user-registration" targetNamespace="https://btt.github.io/processes">
  <bpmn:process id="user-registration" name="Регистрация нового пользователя" isExecutable="false">
    <bpmn:documentation>Отчёт задаёт функцию регистрации пользователя. Поля профиля и уникальность логина и почты приняты по модели BTT. Способ аутентификации и подтверждения почты предстоит определить.</bpmn:documentation>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Enter" name="Заполнить регистрационные данные">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Validate" name="Проверить данные и уникальность логина и почты">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Данные приняты?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Create" name="Создать профиль пользователя">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Registered" name="Пользователь зарегистрирован">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Rejected" name="Регистрация отклонена">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Enter" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Valid" targetRef="Create" name="Да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Create" targetRef="Registered" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Valid" targetRef="Rejected" name="Нет" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_user-registration">
    <bpmndi:BPMNPlane id="Plane_user-registration" bpmnElement="user-registration">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="75" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Enter" bpmnElement="Enter">
        <dc:Bounds x="150" y="136" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Validate">
        <dc:Bounds x="325" y="136" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Valid" bpmnElement="Valid" isMarkerVisible="true">
        <dc:Bounds x="500" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="451.0" y="202" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Create" bpmnElement="Create">
        <dc:Bounds x="675" y="136" width="130" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Registered" bpmnElement="Registered">
        <dc:Bounds x="865" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="809.0" y="195" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected">
        <dc:Bounds x="675" y="270" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="619.0" y="313" width="148" height="38" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="111" y="170.0" />
        <di:waypoint x="150" y="170.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="280" y="170.0" />
        <di:waypoint x="325" y="170.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="455" y="170.0" />
        <di:waypoint x="500" y="170.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="550" y="170.0" />
        <di:waypoint x="675" y="170.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="136" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="805" y="170.0" />
        <di:waypoint x="865" y="170.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="525" y="195" />
        <di:waypoint x="525" y="288" />
        <di:waypoint x="675" y="288" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="260" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>